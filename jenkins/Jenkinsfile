pipeline {

    agent any

    environment {

        DOCKER_USERNAME = "dinesh3715"

        BACKEND_IMAGE = "${DOCKER_USERNAME}/crm-backend"

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/crm-frontend"

        IMAGE_TAG = "${BUILD_NUMBER}"

    }

    stages {

        stage('Checkout Source') {

            steps {

                checkout scm

            }

        }

        stage('Build & Test') {

            parallel {

                stage('Backend') {

                    steps {

                        dir('Backend') {

                            bat 'pip install -r requirements.txt'

                            bat 'python manage.py test'

                        }

                    }

                }

                stage('Frontend') {

                    steps {

                        dir('Frontend') {

                            bat 'npm install'

                            bat 'npm run build'

                        }

                    }

                }

            }

        }

        stage('Build Docker Images') {

            parallel {

                stage('Backend Image') {

                    steps {

                        dir('Backend') {

                            bat """
                            docker build ^
                            -t %BACKEND_IMAGE%:%IMAGE_TAG% ^
                            -t %BACKEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

                stage('Frontend Image') {

                    steps {

                        dir('Frontend') {

                            bat """
                            docker build ^
                            -t %FRONTEND_IMAGE%:%IMAGE_TAG% ^
                            -t %FRONTEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

            }

        }

        stage('DockerHub Login') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat """
                    docker logout
                    docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                    """

                }

            }

        }

        stage('Push Docker Images') {

            parallel {

                stage('Backend Push') {

                    steps {

                        retry(3) {

                            bat "docker push %BACKEND_IMAGE%:%IMAGE_TAG%"

                        }

                        retry(3) {

                            bat "docker push %BACKEND_IMAGE%:latest"

                        }

                    }

                }

                stage('Frontend Push') {

                    steps {

                        retry(3) {

                            bat "docker push %FRONTEND_IMAGE%:%IMAGE_TAG%"

                        }

                        retry(3) {

                            bat "docker push %FRONTEND_IMAGE%:latest"

                        }

                    }

                }

            }

        }

        stage('Deploy to Kubernetes') {

            steps {

                bat "kubectl apply -f k8s/"

                bat """
                kubectl set image deployment/backend ^
                backend=%BACKEND_IMAGE%:%IMAGE_TAG% ^
                -n crm
                """

                bat """
                kubectl set image deployment/frontend ^
                frontend=%FRONTEND_IMAGE%:%IMAGE_TAG% ^
                -n crm
                """

            }

        }

        stage('Wait for Rollout') {

            steps {

                bat """
                kubectl rollout status deployment/backend -n crm --timeout=300s
                """

                bat """
                kubectl rollout status deployment/frontend -n crm --timeout=300s
                """

            }

        }

        stage('Database Migration') {

            steps {

                powershell '''

                kubectl wait --for=condition=Ready pod -l app=backend -n crm --timeout=300s

                $pod = kubectl get pods -n crm -l app=backend --field-selector=status.phase=Running -o jsonpath="{.items[0].metadata.name}"

                kubectl exec -n crm $pod -- python manage.py migrate

                '''

            }

        }

        stage('Verify Deployment') {

            steps {

                bat "kubectl get deployment -n crm"

                bat "kubectl get pods -n crm"

                bat "kubectl get svc -n crm"

            }

        }

    }

    post {

        success {

            echo "=============================================="

            echo " CRM APPLICATION DEPLOYED SUCCESSFULLY "

            echo "=============================================="

        }

        failure {

            echo "=============================================="

            echo " CRM APPLICATION DEPLOYMENT FAILED "

            echo "=============================================="

        }

        always {

            bat "docker image prune -f"

            cleanWs()

        }

    }

}