pipeline {

    agent any

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

    }

    environment {

        DOCKER_USERNAME = "dinesh3715"

        BACKEND_IMAGE = "${DOCKER_USERNAME}/crm-backend"

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/crm-frontend"

        IMAGE_TAG = "${BUILD_NUMBER}"

    }

    stages {

        stage('Checkout Source') {

            steps {

                echo "=========================================="

                echo "Checking out CRM Source Code..."

                echo "=========================================="

                checkout scm

            }

        }

        stage('Build & Test') {

            failFast true

            parallel {

                stage('Backend') {

                    steps {

                        dir('Backend') {

                            bat 'python -m pip install --upgrade pip'

                            bat 'pip install -r requirements.txt'

                            bat 'python manage.py test'

                        }

                    }

                }

                stage('Frontend') {

                    steps {

                        dir('Frontend') {

                            bat 'npm install'

                            bat 'npm run build'

                        }

                    }

                }

            }

        }

        stage('Build Docker Images') {

            failFast true

            parallel {

                stage('Backend Image') {

                    steps {

                        dir('Backend') {

                            bat """
                            docker build ^
                            -t %BACKEND_IMAGE%:%IMAGE_TAG% ^
                            -t %BACKEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

                stage('Frontend Image') {

                    steps {

                        dir('Frontend') {

                            bat """
                            docker build ^
                            -t %FRONTEND_IMAGE%:%IMAGE_TAG% ^
                            -t %FRONTEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

            }

        }

        stage('DockerHub Login') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat """

                    docker logout

                    docker login -u %DOCKER_USER% -p %DOCKER_PASS%

                    """

                }

            }

        }

        stage('Push Docker Images') {

            failFast true

            parallel {

                stage('Backend Push') {

                    steps {

                        retry(3) {

                            bat """

                            docker push %BACKEND_IMAGE%:%IMAGE_TAG%

                            docker push %BACKEND_IMAGE%:latest

                            """

                        }

                    }

                }

                stage('Frontend Push') {

                    steps {

                        retry(3) {

                            bat """

                            docker push %FRONTEND_IMAGE%:%IMAGE_TAG%

                            docker push %FRONTEND_IMAGE%:latest

                            """

                        }

                    }

                }

            }

        }

        stage('Verify Docker Images') {

            steps {

                echo "=========================================="

                echo "Verifying Docker Images..."

                echo "=========================================="

                bat "docker images | findstr crm-backend"

                bat "docker images | findstr crm-frontend"

            }

        }

        stage('Deploy CRM using Ansible') {

            steps {

                echo "=========================================="

                echo "Deploying CRM Application..."

                echo "=========================================="

                bat """
                wsl bash -c "cd /mnt/c/Users/user/Documents/Dinesh_Individual_Projects_Final/Full-Stack_Projects/customer-relationship-management-system/ansible && ansible-playbook -i inventory deploy-crm.yml"
                """

            }

        }

        stage('Verify CRM Deployment') {

            steps {

                echo "=========================================="

                echo "Verifying CRM Deployment..."

                echo "=========================================="

                bat "kubectl get deployment -n crm"

                bat "kubectl get pods -n crm"

                bat "kubectl get svc -n crm"

            }

        }

        stage('Deploy Monitoring') {

            steps {

                echo "=========================================="

                echo "Deploying Prometheus & Grafana..."

                echo "=========================================="

                bat "kubectl apply -f monitoring/"

            }

        }
                stage('Restart Prometheus') {

            steps {

                echo "=========================================="

                echo "Restarting Prometheus..."

                echo "=========================================="

                bat """
                kubectl rollout restart deployment/prometheus -n monitoring
                """

                bat """
                kubectl rollout status deployment/prometheus ^
                -n monitoring ^
                --timeout=300s
                """

            }

        }

        stage('Wait for Monitoring Rollout') {

            steps {

                echo "=========================================="

                echo "Waiting for Monitoring Stack..."

                echo "=========================================="

                bat """
                kubectl rollout status deployment/grafana ^
                -n monitoring ^
                --timeout=300s
                """

                bat """
                kubectl wait ^
                --for=condition=Available ^
                deployment/prometheus ^
                -n monitoring ^
                --timeout=300s
                """

                bat """
                kubectl wait ^
                --for=condition=Available ^
                deployment/grafana ^
                -n monitoring ^
                --timeout=300s
                """

            }

        }

        stage('Verify Monitoring') {

            steps {

                echo "=========================================="

                echo "Verifying Monitoring Stack..."

                echo "=========================================="

                bat "kubectl get deployment -n monitoring"

                bat "kubectl get pods -n monitoring"

                bat "kubectl get svc -n monitoring"

                bat "kubectl get configmap -n monitoring"

                bat "kubectl get pvc -n monitoring"

            }

        }

        stage('Deployment Information') {

            steps {

                echo "=========================================="

                echo "Running Docker Images"

                echo "=========================================="

                bat """
                kubectl get deployment backend ^
                -n crm ^
                -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

                bat """
                kubectl get deployment frontend ^
                -n crm ^
                -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

                bat """
                kubectl get deployment prometheus ^
                -n monitoring ^
                -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

                bat """
                kubectl get deployment grafana ^
                -n monitoring ^
                -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

            }

        }

    }

    post {

        success {

            echo ""

            echo "========================================================"

            echo " CRM APPLICATION DEPLOYED SUCCESSFULLY "

            echo "========================================================"

            echo ""

            echo "CRM Namespace"

            bat "kubectl get all -n crm"

            echo ""

            echo "Monitoring Namespace"

            bat "kubectl get all -n monitoring"

        }

        failure {

            echo ""

            echo "========================================================"

            echo " CRM APPLICATION DEPLOYMENT FAILED "

            echo "========================================================"

            echo ""

            bat "kubectl get pods -A"

            bat "kubectl get events -A --sort-by=.metadata.creationTimestamp"

        }

        always {

            echo ""

            echo "=========================================="

            echo "Cleaning Docker Images..."

            echo "=========================================="

            bat "docker image prune -af"

            echo ""

            echo "=========================================="

            echo "Cleaning Jenkins Workspace..."

            echo "=========================================="

            cleanWs()

        }

    }

}