pipeline {

    agent any

    environment {

        BACKEND_IMAGE = "dinesh3715/crm-backend:latest"
        FRONTEND_IMAGE = "dinesh3715/crm-frontend:latest"

    }

    stages {

        stage('Checkout Source') {

            steps {

                git branch: 'main',
                url: 'https://github.com/DineshDNS/CRM-Application.git'

            }

        }

        stage('Build & Test') {

            parallel {

                stage('Backend') {

                    steps {

                        dir('Backend') {

                            bat 'pip install -r requirements.txt'

                            bat 'python manage.py test'

                            bat 'docker build -t %BACKEND_IMAGE% .'

                        }

                    }

                }

                stage('Frontend') {

                    steps {

                        dir('Frontend') {

                            bat 'npm install'

                            bat 'npm run build'

                            bat 'docker build -t %FRONTEND_IMAGE% .'

                        }

                    }

                }

            }

        }

        stage('Push Images') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat 'docker login -u %DOCKER_USER% -p %DOCKER_PASS%'

                    bat 'docker push %BACKEND_IMAGE%'

                    bat 'docker push %FRONTEND_IMAGE%'

                }

            }

        }

        stage('Deploy Kubernetes') {

            steps {

                bat 'kubectl apply -f k8s/'

                bat 'kubectl rollout restart deployment backend'

                bat 'kubectl rollout restart deployment frontend'

                bat 'kubectl rollout status deployment/backend'

                bat 'kubectl rollout status deployment/frontend'

            }

        }

        stage('Database Migration') {

            steps {

                powershell '''

                kubectl wait --for=condition=Ready pod -l app=backend --timeout=180s

                $pod = kubectl get pods -l app=backend --field-selector=status.phase=Running -o jsonpath="{.items[0].metadata.name}"

                kubectl exec $pod -- python manage.py migrate

                '''

            }

        }

        stage('Verification') {

            steps {

                bat 'kubectl get pods'

                bat 'kubectl get svc'

            }

        }

    }

    post {

        success {

            echo "======================================="

            echo "CRM Deployment Successful"

            echo "======================================="

        }

        failure {

            echo "======================================="

            echo "CRM Deployment Failed"

            echo "======================================="

        }

        always {

            cleanWs()

        }

    }

}