pipeline {

    agent any

    environment {

        DOCKER_USERNAME = "dinesh3715"

        BACKEND_IMAGE = "${DOCKER_USERNAME}/crm-backend"

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/crm-frontend"

        IMAGE_TAG = "${BUILD_NUMBER}"

    }

    stages {

        stage('Checkout Source') {

            steps {

                checkout scm

            }

        }

        stage('Install Backend Dependencies') {

            steps {

                dir('backend') {

                    bat 'pip install -r requirements.txt'

                }

            }

        }

        stage('Install Frontend Dependencies') {

            steps {

                dir('frontend') {

                    bat 'npm install'

                }

            }

        }

        stage('Run Django Tests') {

            steps {

                dir('backend') {

                    bat 'python manage.py test'

                }

            }

        }

        stage('Build React Application') {

            steps {

                dir('frontend') {

                    bat 'npm run build'

                }

            }

        }

        stage('Build Backend Docker Image') {

            steps {

                bat """
                docker build ^
                -t %BACKEND_IMAGE%:%IMAGE_TAG% ^
                -t %BACKEND_IMAGE%:latest ^
                -f docker/backend/Dockerfile .
                """

            }

        }

        stage('Build Frontend Docker Image') {

            steps {

                bat """
                docker build ^
                -t %FRONTEND_IMAGE%:%IMAGE_TAG% ^
                -t %FRONTEND_IMAGE%:latest ^
                -f docker/frontend/Dockerfile .
                """

            }

        }

        stage('Docker Hub Login') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat """
                    docker logout
                    docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                    """

                }

            }

        }

        stage('Push Backend Images') {

            steps {

                bat """
                docker push %BACKEND_IMAGE%:%IMAGE_TAG%
                docker push %BACKEND_IMAGE%:latest
                """

            }

        }

        stage('Push Frontend Images') {

            steps {

                bat """
                docker push %FRONTEND_IMAGE%:%IMAGE_TAG%
                docker push %FRONTEND_IMAGE%:latest
                """

            }

        }

        stage('Deploy to Kubernetes') {

            steps {

                bat """
                kubectl apply --validate=false -f k8s/
                """

            }

        }

        stage('Restart Kubernetes Deployments') {

            steps {

                bat """
                kubectl rollout restart deployment/backend -n crm
                """

                bat """
                kubectl rollout restart deployment/frontend -n crm
                """

            }

        }

        stage('Wait for Backend Deployment') {

            steps {

                bat """
                kubectl rollout status deployment/backend -n crm --timeout=300s
                """

            }

        }

        stage('Wait for Frontend Deployment') {

            steps {

                bat """
                kubectl rollout status deployment/frontend -n crm --timeout=300s
                """

            }

        }

        stage('Verify Kubernetes Resources') {

            steps {

                bat """
                kubectl get pods -n crm
                """

                bat """
                kubectl get svc -n crm
                """

                bat """
                kubectl get ingress -n crm
                """

            }

        }

    }

    post {

        success {

            echo "========================================"
            echo " CRM CI/CD Pipeline Completed Successfully "
            echo "========================================"

        }

        failure {

            echo "========================================"
            echo " CRM CI/CD Pipeline Failed "
            echo "========================================"

        }

        always {

            bat "docker image prune -f"

        }

    }

}