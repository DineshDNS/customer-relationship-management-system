pipeline {

    agent any

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

    }

    environment {

        DOCKER_USERNAME = "dinesh3715"

        BACKEND_IMAGE = "${DOCKER_USERNAME}/crm-backend"

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/crm-frontend"

        IMAGE_TAG = "${BUILD_NUMBER}"

        KUBE_NAMESPACE = "crm"

    }

    stages {

        stage('Checkout Source') {

            steps {

                echo "=========================================="
                echo "Checking out CRM Source Code..."
                echo "=========================================="

                checkout scm

            }

        }

        stage('Build & Test') {

            failFast true

            parallel {

                stage('Backend') {

                    steps {

                        dir('Backend') {

                            bat 'python -m pip install --upgrade pip'

                            bat 'pip install -r requirements.txt'

                            bat 'python manage.py test'

                        }

                    }

                }

                stage('Frontend') {

                    steps {

                        dir('Frontend') {

                            bat 'npm install'

                            bat 'npm run build'

                        }

                    }

                }

            }

        }

        stage('Build Docker Images') {

            failFast true

            parallel {

                stage('Backend Image') {

                    steps {

                        dir('Backend') {

                            bat """
                            docker build ^
                            -t %BACKEND_IMAGE%:%IMAGE_TAG% ^
                            -t %BACKEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

                stage('Frontend Image') {

                    steps {

                        dir('Frontend') {

                            bat """
                            docker build ^
                            -t %FRONTEND_IMAGE%:%IMAGE_TAG% ^
                            -t %FRONTEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

            }

        }

        stage('DockerHub Login') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat """
                    docker logout
                    docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                    """

                }

            }

        }
                stage('Push Docker Images') {

            failFast true

            parallel {

                stage('Backend Push') {

                    steps {

                        retry(3) {

                            bat """
                            docker push %BACKEND_IMAGE%:%IMAGE_TAG%
                            docker push %BACKEND_IMAGE%:latest
                            """

                        }

                    }

                }

                stage('Frontend Push') {

                    steps {

                        retry(3) {

                            bat """
                            docker push %FRONTEND_IMAGE%:%IMAGE_TAG%
                            docker push %FRONTEND_IMAGE%:latest
                            """

                        }

                    }

                }

            }

        }

        stage('Verify Docker Images') {

            steps {

                echo "=========================================="
                echo "Verifying Docker Images..."
                echo "=========================================="

                bat "docker images | findstr crm-backend"

                bat "docker images | findstr crm-frontend"

            }

        }

        stage('Deploy to Kubernetes') {

            steps {

                echo "=========================================="
                echo "Deploying CRM to Kubernetes..."
                echo "=========================================="

                bat "kubectl apply -f k8s/"

                bat """
                kubectl set image deployment/backend ^
                backend=%BACKEND_IMAGE%:%IMAGE_TAG% ^
                -n %KUBE_NAMESPACE%
                """

                bat """
                kubectl set image deployment/frontend ^
                frontend=%FRONTEND_IMAGE%:%IMAGE_TAG% ^
                -n %KUBE_NAMESPACE%
                """

            }

        }

        stage('Wait for Rollout') {

            steps {

                echo "=========================================="
                echo "Waiting for Kubernetes Rollout..."
                echo "=========================================="

                bat """
                kubectl rollout status deployment/backend -n %KUBE_NAMESPACE% --timeout=300s
                """

                bat """
                kubectl rollout status deployment/frontend -n %KUBE_NAMESPACE% --timeout=300s
                """

                bat """
                kubectl wait --for=condition=Available deployment/backend -n %KUBE_NAMESPACE% --timeout=300s
                """

                bat """
                kubectl wait --for=condition=Available deployment/frontend -n %KUBE_NAMESPACE% --timeout=300s
                """

            }

        }

        stage('Database Migration') {

            steps {

                echo "=========================================="
                echo "Running Django Database Migration..."
                echo "=========================================="

                powershell '''

                kubectl wait --for=condition=Ready pod -l app=backend -n crm --timeout=300s

                $pod = kubectl get pods -n crm -l app=backend --field-selector=status.phase=Running -o jsonpath="{.items[0].metadata.name}"

                kubectl exec -n crm $pod -- python manage.py migrate

                '''

            }

        }

        stage('Verify Deployment') {

            steps {

                echo "=========================================="
                echo "Verifying Kubernetes Resources..."
                echo "=========================================="

                bat "kubectl get deployment -n %KUBE_NAMESPACE%"

                bat "kubectl get pods -n %KUBE_NAMESPACE%"

                bat "kubectl get svc -n %KUBE_NAMESPACE%"

                bat "kubectl get rs -n %KUBE_NAMESPACE%"

            }

        }

        stage('Deployment Information') {

            steps {

                echo "=========================================="
                echo "Current Running Images"
                echo "=========================================="

                bat """
                kubectl get deployment backend -n %KUBE_NAMESPACE% -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

                bat """
                kubectl get deployment frontend -n %KUBE_NAMESPACE% -o=jsonpath="{.spec.template.spec.containers[0].image}"
                """

                echo ""

            }

        }

    }

    post {

        success {

            echo ""

            echo "=================================================="

            echo " CRM APPLICATION DEPLOYED SUCCESSFULLY "

            echo "=================================================="

        }

        failure {

            echo ""

            echo "=================================================="

            echo " CRM APPLICATION DEPLOYMENT FAILED "

            echo "=================================================="

        }

        always {

            echo ""

            echo "Cleaning Jenkins Workspace..."

            bat "docker image prune -af"

            cleanWs()

        }

    }

}