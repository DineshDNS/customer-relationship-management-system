pipeline {

    agent any

    environment {

        DOCKER_USERNAME = "dinesh3715"

        BACKEND_IMAGE = "${DOCKER_USERNAME}/crm-backend"

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/crm-frontend"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Source') {

            steps {

                checkout scm

            }

        }

        stage('Build & Test') {

            parallel {

                stage('Backend') {

                    steps {

                        dir('Backend') {

                            bat 'pip install -r requirements.txt'

                            bat 'python manage.py test'

                        }

                    }

                }

                stage('Frontend') {

                    steps {

                        dir('Frontend') {

                            bat 'npm install'

                            bat 'npm run build'

                        }

                    }

                }

            }

        }

        stage('Build Docker Images') {

            parallel {

                stage('Backend Image') {

                    steps {

                        dir('Backend') {

                            bat """
                            docker build ^
                            -t %BACKEND_IMAGE%:%IMAGE_TAG% ^
                            -t %BACKEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

                stage('Frontend Image') {

                    steps {

                        dir('Frontend') {

                            bat """
                            docker build ^
                            -t %FRONTEND_IMAGE%:%IMAGE_TAG% ^
                            -t %FRONTEND_IMAGE%:latest ^
                            .
                            """

                        }

                    }

                }

            }

        }

        stage('DockerHub Push') {

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: 'dockerhub-creds',

                        usernameVariable: 'DOCKER_USER',

                        passwordVariable: 'DOCKER_PASS'

                    )

                ]) {

                    bat """
                    docker logout
                    docker login -u %DOCKER_USER% -p %DOCKER_PASS%

                    docker push %BACKEND_IMAGE%:%IMAGE_TAG%
                    docker push %BACKEND_IMAGE%:latest

                    docker push %FRONTEND_IMAGE%:%IMAGE_TAG%
                    docker push %FRONTEND_IMAGE%:latest
                    """

                }

            }

        }

        stage('Deploy to Kubernetes') {

            steps {

                bat "kubectl apply -f k8s/"

                bat "kubectl rollout restart deployment/backend -n crm"

                bat "kubectl rollout restart deployment/frontend -n crm"

                bat "kubectl rollout status deployment/backend -n crm --timeout=300s"

                bat "kubectl rollout status deployment/frontend -n crm --timeout=300s"

            }

        }

        stage('Verification') {

            steps {

                powershell '''

                kubectl wait --for=condition=Ready pod -l app=backend -n crm --timeout=180s

                $pod = kubectl get pods -n crm -l app=backend --field-selector=status.phase=Running -o jsonpath="{.items[0].metadata.name}"

                kubectl exec -n crm $pod -- python manage.py migrate

                '''

                bat "kubectl get pods -n crm"

                bat "kubectl get svc -n crm"

                bat "kubectl get ingress -n crm"

            }

        }

    }

    post {

        success {

            echo "========================================"
            echo " CRM CI/CD Pipeline Completed Successfully "
            echo "========================================"

        }

        failure {

            echo "========================================"
            echo " CRM CI/CD Pipeline Failed "
            echo "========================================"

        }

        always {

            bat "docker image prune -f"

            cleanWs()

        }

    }

}